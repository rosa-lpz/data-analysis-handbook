	partition fruits_filtered_color = calculated
		mode: import
		source =
				
				TOPN(
				    COUNTROWS( 'fruits_db' ),
				    FILTER( 'fruits_db', [Color] = "Passed" ),
				    [Fruit],
				    ASC
				)

	annotation PBI_Id = d649d830e9d8486aab34dd70dc0a25fb

